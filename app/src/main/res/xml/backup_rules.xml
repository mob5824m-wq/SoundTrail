<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup (Android 11 and lower; see data_extraction_rules.xml for 12+).

  Only the library the listener built is eligible: pins, playlists, and automation rules.
  An <include> turns this file into an allowlist, so everything not listed here is already
  left out of the backup and there is nothing to exclude. That covers the Keystore-encrypted
  token store, the cloud-sync session and recovery-key state, the mood settings and last mood
  description, the activity-recognition opt-in, Google auth status, server settings, the
  audio files, and Soundtrail's own managed snapshots. A backup restored on another device
  could not decrypt the tokens anyway, and uploading ciphertext that cannot be opened would
  only be a privacy claim without a use.

  This file used to list those exclusions as <exclude> entries. They were redundant — an
  allowlist cannot contain a path it never included — and Android lint treats a redundant
  exclude as a fatal FullBackupContent error ("X is not in an included path"). Fatal lint
  findings fail :app:lintVitalRelease, which `assembleRelease` depends on: the release
  variant would not build at all, for F-Droid's buildserver or for anyone else. The
  exclusions are recorded here as comments instead, where they document the intent without
  claiming a rule the platform ignores.
-->
<full-backup-content>
    <include domain="sharedpref" path="soundtrail_pins.xml" />
    <include domain="sharedpref" path="soundtrail_playlists.xml" />
    <include domain="sharedpref" path="soundtrail_automations.xml" />

    <!-- Deliberately NOT included, and therefore never backed up:
         sharedpref/soundtrail_secrets.xml                Keystore-encrypted tokens and API keys
         sharedpref/soundtrail_google_auth.xml             Google account status
         sharedpref/soundtrail_cloud_sync.xml              sync session and recovery-key state
         sharedpref/soundtrail_youtube.xml                 YouTube OAuth client ID and imports
         sharedpref/soundtrail_settings.xml                server addresses and preferences
         sharedpref/soundtrail_mood.xml                    mood settings and last description
         sharedpref/soundtrail_mood_consent.xml            mood provider consent records
         sharedpref/soundtrail_activity_recognition.xml    motion opt-in
         sharedpref/soundtrail_backups.xml                 managed-snapshot bookkeeping
         file/audio                                        imported audio the listener owns
         file/managed-backups                              Soundtrail's own on-device snapshots
    -->
</full-backup-content>
