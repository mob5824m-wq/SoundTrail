<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only for the opt-in automation watch: a visible foreground service, never hidden tracking. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Background Jellyfin streaming: the playback notification's foreground service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lists the device's microG/Google account so Connect Google can use it without a picker. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Android 11+ limits package visibility. These are only used for app-status checks and handoff. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.soundcloud.android" />
        <package android:name="app.morphe.android.apps.youtube.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="app.revanced.android.apps.youtube.music" />
        <package android:name="app.revanced.android.youtube.music" />
        <package android:name="app.revanced.android.gms" />
        <package android:name="com.mgoogle.android.gms" />
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_soundtrail"
        android:roundIcon="@mipmap/ic_soundtrail"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soundtrail">
        <!-- What Android Auto may ask this app for; see res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Register this EXACT URI in the Spotify Developer Dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.soundtrail" android:host="spotify-auth" />
            </intent-filter>
            <!-- Register this EXACT URI in your SoundCloud API app settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.soundtrail" android:host="soundcloud-auth" />
            </intent-filter>
            <!-- Browser-based YouTube OAuth (Desktop client): works with MicroG RE or no Google
                 services. Google's documented custom-scheme form is scheme:/path; the equivalent
                 scheme://host form is accepted too. Each form needs its own filter because a
                 filter that declares a host never matches a host-less URI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.soundtrail" android:path="/youtube-auth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.soundtrail" android:host="youtube-auth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Opt-in automation watch: visible foreground service, location type declared. -->
        <service
            android:name=".automation.LocationWatchService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Jellyfin streaming continues outside the app under a MediaStyle notification. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          What Android Auto browses and drives. The car runs in another app, so this one has to
          be exported; it serves only the library the user saved on this phone, and onGetRoot
          refuses callers that are not the car host or the system's own media UI.
        -->
        <service
            android:name=".auto.SoundtrailAutoService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Shares the user's imported audio files read-only with their chosen player. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
