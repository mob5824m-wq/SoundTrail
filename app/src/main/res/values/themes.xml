<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent is the framework's Material theme, and it stays that way on purpose. Every colour this
  app shows comes from Compose (ui/Theme.kt), so this style only carries the window chrome below —
  the status and navigation bar colours and the light/dark icon choice.

  It is worth recording what would change it: an AppCompat parent is only needed if something in
  the app inflates an AppCompatDialogFragment, which is what androidx.biometric does below API 28.
  The recovery-key unlock goes through KeyguardManager instead, so nothing here needs AppCompat and
  no androidx.appcompat dependency comes with it.
-->
<resources>
    <style name="Theme.Soundtrail" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#101114</item>
        <item name="android:navigationBarColor">#101114</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
