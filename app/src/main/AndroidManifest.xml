<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only for the opt-in automation watch: a visible foreground service, never hidden tracking. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Background Jellyfin streaming: the playback notification's foreground service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice: asked for at the moment the microphone button is pressed, never at launch, and
         only while a listen is running. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Android 11+ limits package visibility, and it hides speech engines as well: without these
      the voice features would find no recognizer and no text-to-speech on a phone that has both.

      No music app is queried any more. Spotify, SoundCloud and YouTube Music — including the
      Morphe and ReVanced package names this list used to carry — were removed along with the
      services they belonged to, so nothing in this app asks the package manager about another
      app's music player, and no link is handed off to one.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_soundtrail"
        android:roundIcon="@mipmap/ic_soundtrail"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soundtrail">
        <!-- What Android Auto may ask this app for; see res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              No app.soundtrail:// OAuth redirect filters any more. Spotify, SoundCloud and the
              browser-based YouTube flow each needed one to catch their authorization response;
              those services are gone, so the only deep link this activity accepts is a shared
              piece of text, below.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Opt-in automation watch: visible foreground service, location type declared. -->
        <service
            android:name=".automation.LocationWatchService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Jellyfin streaming continues outside the app under a MediaStyle notification. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          What Android Auto browses and drives. The car runs in another app, so this one has to
          be exported; it serves only the library the user saved on this phone, and onGetRoot
          refuses callers that are not the car host or the system's own media UI.
        -->
        <service
            android:name=".auto.SoundtrailAutoService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Shares the user's imported audio files read-only with their chosen player. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
