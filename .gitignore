# Android / Gradle
.gradle/
**/build/
local.properties
*.iml
.idea/
.cxx/
.externalNativeBuild/

# Signing keys and local credentials
*.jks
*.keystore
*.properties.local
# Note: keystore/soundtrail-debug.p12 is committed on purpose — every debug build,
# local and CI, shares that one key so an APK installs as an update over the last one.
# It holds the standard public debug credentials (androiddebugkey / android).

# Python / self-hosted server
__pycache__/
*.py[cod]
.venv/
# Local sync database (default location when SOUNDTRAIL_DB is unset)
server/data/
*.sqlite3
*.sqlite3-*

# OS / editor
.DS_Store
*.swp

# F-Droid tooling virtualenvs (tools/fdroid_lint.py needs fdroidserver)
.venv-*/
